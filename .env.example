# MindCare Environment Variables
# Copy this file to .env and fill in your credentials

# 1. Supabase Credentials (from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 2. Google Gemini API Key (from Google AI Studio: https://aistudio.google.com/)
# Used for the 'Beyond' AI mental health companion chatbot widget
VITE_GEMINI_API_KEY=your-gemini-api-key-here
